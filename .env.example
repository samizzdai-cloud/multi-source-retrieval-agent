# Copy this file to .env and fill in local credentials. Never commit .env.

# DeepSeek is used by the global planner and eval path by default.
DEEPSEEK_API_KEY=

# Feishu OAuth application configuration. Use the browser flow below to create
# FEISHU_UAT and FEISHU_REFRESH_TOKEN locally; do not paste either into this file.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
FEISHU_OAUTH_SCOPES=offline_access search:docs:read
FEISHU_UAT=
FEISHU_UAT_EXPIRES_AT=
FEISHU_REFRESH_TOKEN=
FEISHU_REFRESH_TOKEN_EXPIRES_AT=

# Balanced and deep_dive Feishu presets use Qwen rerank after I/O.
RERANK_API_KEY=
RERANK_WORKSPACE_ID=
RERANK_MODEL=qwen3-rerank

# Feishu-only local defaults.
RAG_PRESET=balanced
# Post-read content rerank only. Pre-read child-table selection is independent.
RAG_FEISHU_CONTENT_RERANK=all
RAG_ENABLED_SOURCES=feishu
# Optional override. Web defaults to its retrieval-stage budget, other roots to 45 seconds.
# RAG_FEISHU_SOURCE_TIMEOUT_S=45
RAG_WEB_RETRIEVE_TIMEOUT_S=200
RAG_WEB_ANSWER_TIMEOUT_S=120
RAG_GLOBAL_PLANNER_TIMEOUT_S=15
# Shared in-flight MCP search slots; this is a concurrency cap, not a QPS promise.
FEISHU_MCP_SEARCH_MAX_CONCURRENCY=6
